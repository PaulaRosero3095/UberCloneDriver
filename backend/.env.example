# Port of the Express server
PORT=3000
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
MP_ACCESS_TOKEN=TEST-tu-token-de-mercado-pago
PAYMENT_RETURN_URL=https://uberclone-conductor.example/pago

# Path to the Firebase service-account key (Firebase console > Project settings >
# Service accounts > Generate new private key). NEVER commit this file.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Mercado Pago TEST access token (Developers > Your integrations > Test credentials)
MP_ACCESS_TOKEN=

# URL the checkout returns to. The app intercepts it inside the WebView,
# so it does not need to exist. Must be https.
PAYMENT_RETURN_URL=https://uberclone-conductor.example/pago

# Optional: public https URL of this server (e.g. an ngrok tunnel) so Mercado Pago can
# call the webhook. Without it the app confirms the payment itself after checkout.
# PUBLIC_URL=
