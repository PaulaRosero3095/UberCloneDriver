# Copy this file to .env and fill in your own values. Never commit .env.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Cloudinary: only the cloud name and an UNSIGNED upload preset (no secrets in the app)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Optional: map tiles when there is no Google key. If the map is blank, try one of these:
# EXPO_PUBLIC_MAP_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}
# EXPO_PUBLIC_MAP_ATTRIBUTION=Tiles © Esri
# EXPO_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
